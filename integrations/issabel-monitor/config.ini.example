# /etc/tldeck-monitor/config.ini  (dono asterisk, permissão 600)
# Valores omitidos usam o padrão do coletor.

[http]
# Só a interface interna. Nunca 0.0.0.0.
bind = 10.10.0.235
port = 9118
# Gerado pelo install.sh (openssl rand -hex 32). O mesmo valor vai em ISSABEL_TOKEN no TLDeck.
token = __TOKEN__
# Quem pode consultar: IPs, redes (CIDR) e nomes de máquina (resolvidos de novo a cada 5 min).
# O token continua obrigatório mesmo para quem está na lista.
allow = desktop-vmuj97q, 10.10.0.0/24

[paths]
monitor_root = /var/spool/asterisk/monitor
log_file = /var/log/asterisk/full
cli_socket = /var/run/asterisk/asterisk.ctl
# Escrito pelo timer tldeck-issabel-audit (root) a cada 5 min.
audit_file = /var/lib/tldeck-monitor/audit.txt
# Outras partições para espaço/inodes (a das gravações sempre entra; mesma partição aparece uma vez).
disk_paths = /, /var/lib/mysql, /var/log

[service]
unit = asterisk.service

[cdr]
enabled = true
mysql_bin = mysql
# Usuário MySQL somente leitura (veja README). Arquivo 600, dono asterisk.
defaults_file = /etc/tldeck-monitor/mysql.cnf
database = asteriskcdrdb
# Janela da comparação CDR × disco (a taxa crítica olha só a última hora).
hours = 2
max_rows = 20000
# Chamadas que terminaram há menos que isso são ignoradas (arquivo ainda sendo fechado).
grace_minutes = 2
# Serviço do banco: o primeiro que existir.
db_units = mariadb.service, mysqld.service, mysql.service

[calls]
# Direção pelo CDR: entrada pelo dcontext; saída = contexto interno discando número externo.
inbound_context_re = ^(from-trunk|from-pstn|ext-did|from-did|from-sip-external|from-dahdi)
outbound_context_re = ^(from-internal|macro-dialout|outbound|outrt)
outbound_dst_re = ^\+?\d{7,}$
window_minutes = 60
# Falhas = FAILED/CONGESTION. Só avalia com pelo menos min_calls ligações na janela.
min_calls = 5
fail_warn_pct = 20
fail_crit_pct = 50
# Nenhuma ligação entrando na janela, nesse horário, vira atenção (vazio = nunca). Dias: 1=seg … 7=dom.
business_hours = 08:00-18:00
business_days = 1-5

[ami]
enabled = true
host = 127.0.0.1
port = 5038
user = tldeck
secret = __AMI_SECRET__
# Peers/endpoints cujo nome casa com isso são ramais; os demais são troncos.
extension_re = ^\d{2,6}$
timeout = 8

[thresholds]
disk_warn = 80
disk_crit = 90
# Gravação com até esse tamanho é considerada vazia (só o cabeçalho WAV).
empty_bytes = 44
audit_hours = 24
cpu_warn = 85
cpu_crit = 95
mem_warn = 85
mem_crit = 95
# Consulta ao MySQL acima disso (ms) = lento.
db_slow_ms = 2000

[intervals]
# segundos: serviço, log, CPU/RAM / permissões, disco, CLI, AMI, MySQL / CDR (gravações e ligações) / auditoria
fast = 30
normal = 60
cdr = 120
slow = 300
